{
    "name": "ML Resume Matcher",
    "image": "mcr.microsoft.com/devcontainers/python:3.11",
    "features": {
        "ghcr.io/devcontainers/features/common-utils:2": {},
        "ghcr.io/devcontainers/features/git:1": {}
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.flake8",
                "ms-toolsai.jupyter"
            ]
        }
    },
    "postCreateCommand": "pip install -r requirements.txt && mkdir -p uploads",
    "forwardPorts": [5009],
    "portsAttributes": {
        "5009": {
            "label": "ML Resume Matcher",
            "onAutoForward": "openBrowser"
        }
    },
    "remoteUser": "vscode"
}